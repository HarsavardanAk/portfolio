V</span>\r\n          <span className=\"navbar__brand-name\">Harsa Vardan</span>\r\n        </a>\r\n\r\n        <ul className={`navbar__links ${menuOpen ? \"navbar__links--open\" : \"\"}`}>\r\n          {links.map((l) => (\r\n            <li key={l.href}>\r\n              <a\r\n                href={l.href}\r\n                className={`navbar__link ${active === l.href ? \"navbar__link--active\" : \"\"}`}\r\n                onClick={() => setMenuOpen(false)}\r\n              >\r\n                {l.label}\r\n              </a>\r\n            </li>\r\n          ))}\r\n        </ul>\r\n\r\n        <a\r\n  href=\"#contact\"\r\n  className=\"navbar__cta\"\r\n  onClick={() => setMenuOpen(false)}\r\n>\r\n  Hire Me\r\n</a>\r\n\r\n        <button className={`navbar__burger ${menuOpen ? \"open\" : \"\"}`} onClick={() => setMenuOpen(!menuOpen)} aria-label=\"Menu\">\r\n          <span /><span /><span />\r\n        </button>\r\n      </div>\r\n    </nav>\r\n  );\r\n}\r\n"],"mappings":"AAAA;AACA,OAASA,QAAQ,CAAEC,SAAS,KAAQ,OAAO,CAC3C,MAAO,cAAc,CAAC,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAEtB,KAAM,CAAAC,KAAK,CAAG,CACZ,CAAEC,KAAK,CAAE,OAAO,CAAQC,IAAI,CAAE,QAAS,CAAC,CACxC,CAAED,KAAK,CAAE,YAAY,CAAGC,IAAI,CAAE,aAAc,CAAC,CAC7C,CAAED,KAAK,CAAE,UAAU,CAAKC,IAAI,CAAE,WAAY,CAAC,CAC3C,CAAED,KAAK,CAAE,QAAQ,CAAOC,IAAI,CAAE,SAAU,CAAC,CACzC,CAAED,KAAK,CAAE,WAAW,CAAIC,IAAI,CAAE,YAAa,CAAC,CAC5C,CAAED,KAAK,CAAE,SAAS,CAAMC,IAAI,CAAE,UAAW,CAAC,CAC3C,CAED,cAAe,SAAS,CAAAC,MAAMA,CAAA,CAAG,CAC/B,KAAM,CAACC,QAAQ,CAAEC,WAAW,CAAC,CAAGX,QAAQ,CAAC,KAAK,CAAC,CAC/C,KAAM,CAACY,MAAM,CAAIC,SAAS,CAAC,CAAKb,QAAQ,CAAC,EAAE,CAAC,CAC5C,KAAM,CAACc,QAAQ,CAAEC,WAAW,CAAC,CAAGf,QAAQ,CAAC,KAAK,CAAC,CAE/CC,SAAS,CAAC,IAAM,CACd,KAAM,CAAAe,QAAQ,CAAGA,CAAA,GAAM,CACrBL,WAAW,CAACM,MAAM,CAACC,OAAO,CAAG,EAAE,CAAC,CAChC,KAAM,CAAAC,QAAQ,CAAGb,KAAK,CAACc,GAAG,CAACC,CAAC,EAAIC,QAAQ,CAACC,aAAa,CAACF,CAAC,CAACb,IAAI,CAAC,CAAC,CAC/DW,QAAQ,CAACK,OAAO,CAAEC,GAAG,EAAK,CACxB,GAAI,CAACA,GAAG,CAAE,OACV,KAAM,CAAAC,IAAI,CAAGD,GAAG,CAACE,qBA